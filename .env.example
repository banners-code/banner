# Copy this file to .env.local and add the secret key from Decart's platform dashboard.
DECART_API_KEY=your-decart-api-key

# Supabase project configuration. The publishable key is safe for browser use when
# every exposed table has Row Level Security enabled.
VITE_SUPABASE_URL=https://nysicgwtjnhynfbwxdye.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_dQ6N_rzloPeIB2gX1K_ROg__5w_28X_

# Server only. Never prefix this with VITE_ or commit its real value.
# Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted by the Node server.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Local development. In production, list the exact HTTPS origin(s) that serve the app.
APP_ORIGINS=http://localhost:5173

# Set to the number of trusted reverse proxies in production. Leave at 0 locally.
TRUST_PROXY_HOPS=0
# Bachs automatic checkout remains disabled until server integration and verification are complete.
# BACHS_API_KEY=
# BACHS_WEBHOOK_SECRET=
# BACHS_SUCCESS_URL=https://your-domain.example/dashboard
# BACHS_CANCEL_URL=https://your-domain.example/dashboard
